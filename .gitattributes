# Only what runs on a server goes into a Composer install (dist archive) or a
# GitHub release archive: src/, bootstrap.php, config/, LICENSE, README.md,
# CHANGELOG.md, SECURITY.md. Everything for developing the library stays in
# the repository.
/.github            export-ignore
/bench              export-ignore
/docs               export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/AGENTS.md          export-ignore
/CONTRIBUTING.md    export-ignore
/phpstan.neon.dist  export-ignore
/psalm.xml          export-ignore

# Line endings: LF everywhere, whatever the checkout platform.
* text=auto eol=lf
