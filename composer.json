{
    "name": "cjw-network/request-shield",
    "description": "A mini web application firewall for PHP: it checks every request before your site's code runs, turns away junk and floods, keeps page caches clean and makes bots pay — even on shared hosting.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "JAC Systeme GmbH",
            "homepage": "https://www.jac-systeme.de",
            "role": "Author"
        },
        {
            "name": "CJW Network",
            "homepage": "https://cjw-network.com"
        }
    ],
    "keywords": [
        "security",
        "waf",
        "web application firewall",
        "firewall",
        "rate limiting",
        "bot protection",
        "proof of work",
        "dos",
        "cache",
        "cache pollution",
        "shared hosting"
    ],
    "require": {
        "php": ">=8.0"
    },
    "suggest": {
        "ext-apcu": "Counters in shared memory (the file store is used without it)"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "CjwNetwork\\RequestShield\\": ["src/", "plugins/stats/src/"]
        }
    },
    "bin": [
        "bin/request-shield"
    ],
    "scripts": {
        "test": "php tests/run.php",
        "phpstan": "phpstan analyse",
        "psalm": "psalm --no-cache",
        "taint": "psalm --no-cache --taint-analysis"
    },
    "config": {
        "sort-packages": true
    }
}
