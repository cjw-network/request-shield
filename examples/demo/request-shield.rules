# The demo site's rules. Low limits on purpose, so every reaction can be seen
# within a few clicks; a real site uses the defaults or more.
#
# Every rule has its own ID -- [DEMO-...] -- and the comment after it is its
# description on the active rules page (/rules). Decisions and the log name
# the ID: X-Request-Shield: reject restricted; rule=DEMO-ADMIN
# The built-in blocks come from the library's rules/scanners.rules (SCAN-...).
#
# The paths start with **/ so the demo works in any directory (/demo/page/about,
# /demo/index.php/page/about). A real site writes them from its root: /page/*.

ids DEMO
version 2026-09-29.1        # this rule set's own version: shown on /rules and by check

# What a cache may keep. Anything else passes too -- the site answers it, 200
# or 404 -- but marked "allow-uncached", so made-up URLs cannot fill a cache.
# (A CMS whose URLs change all the time keeps "cache-path any", the default,
# and counts its cache misses per client instead: an on-demand budget.)
[DEMO-CACHE]        cache-path  **/  **/index.php  **/page/*      # the front page and /page/<name> may be cached
[DEMO-CACHE-QUERY]  cache-query page                              # only the parameter "page" may be in a cached address

# The search page takes any ?q= -- answered, never cached -- and counts every
# search against its own budget (on-demand: the page counts, see index.php).
[DEMO-SEARCH]       limit searches 10/min on-demand               # at most 10 searches a minute per visitor

[DEMO-FORMS]        allow POST  **/edit **/comment **/profile     # forms may only be sent to the edit, comment and profile pages

[DEMO-ADMIN]        restrict **/admin/**  to 192.0.2.0/24         # the admin area: only the office network
[DEMO-API]          restrict **/api/**    to 127.0.0.1 ::1        # the API: only this machine
[DEMO-RULES]        restrict **/rules     to 127.0.0.1 ::1        # this rules page: only this machine

# The path check stays even here: /files/%2e%2e/secret is still refused (400).
# @1: the revision of the built-in rules this was reviewed for -- when a library
# update changes them, check and /rules say so (the rules keep applying).
[DEMO-FILES]        unblock [SCAN-HIDDEN@1] [SCAN-BACKUP@1]  at **/files/**  for 127.0.0.1 ::1   # the admin's file reader may open hidden files and backups, from this machine

[DEMO-PACE]         limit requests 60/min challenge-at 20          # per visitor: browser check past 20 requests a minute, a pause past 60
[DEMO-LOGIN]        challenge   **/challenge                       # a page where every visitor is checked, as a login would be

# The demo runs on your own machine: count localhost too (a real site exempts
# its monitoring and its own servers here).
[DEMO-EXEMPT]       exempt none                                    # nobody is exempt from counting, not even this machine

# A passed check is valid for one minute here, so you can watch it expire; a
# real site keeps it an hour or more (the default: 1h).
set         pass-ttl 1m
set         difficulty-min 50000
set         difficulty-max 300000
set         search-engines off

# Counters, the generated secret and the log: outside the document root,
# never in a directory a web server might hand out (the tests set the variable).
set         store-dir ${REQUEST_SHIELD_DEMO_VAR:-/tmp/request-shield-demo}
set         log ${REQUEST_SHIELD_DEMO_VAR:-/tmp/request-shield-demo}/shield.log
set         log-level flag
set         recheck 0

# The site may ask for the browser check itself: Shield::active()->requirePass()
# when a comment is sent (/comment), or the response header
# X-Request-Shield-Challenge: required on a page (/profile) -- the latter needs:
set         app-challenge on

# X-Request-Shield: <decision> <reason>; rule=<ID> on every response.
set         debug-header on
