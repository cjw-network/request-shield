# The demo site's rules. Low limits on purpose, so every reaction can be seen
# within a few clicks; a real site uses the defaults or more.
#
# Every rule has its own ID -- [DEMO-...] -- and the comment after it is its
# description on the active rules page (/rules). Decisions and the log name
# the ID: X-RS: reject restricted; rule=DEMO-ADMIN
# The built-in blocks come from the library's rules/scanners.rules (SCAN-...).
#
# The paths start with **/ so the demo works in any directory (/demo/page/about,
# /demo/index.php/page/about). A real site writes them from its root: /page/*.

ids DEMO
version 2026-09-29.1        # this rule set's own version: shown on /rules and by check

# What a cache may keep. Anything else passes too -- the site answers it, 200
# or 404 -- but marked "allow-uncached", so made-up URLs cannot fill a cache.
# (A CMS whose URLs change all the time keeps "cache-path any", the default,
# and counts its cache misses per client instead: an on-demand budget.)
# A proxy in front of the site (a documentation address): from it, X-Forwarded-For
# names the visitor. The tests add 127.0.0.1 here, to send each example's address.
trust       198.51.100.1
trust       ${REQUEST_SHIELD_DEMO_TRUST:-198.51.100.1}

[DEMO-CACHE]        cache-path  **/  **/index.php  **/page/*      # the front page and /page/<name> may be cached
[DEMO-CACHE-QUERY]  cache-query page                              # only the parameter "page" may be in a cached address

# The search page takes any ?q= -- answered, never cached -- and counts every
# search against its own budget (on-demand: the page counts, see index.php).
[DEMO-SEARCH]       limit searches 10/min on-demand               # at most 10 searches a minute per visitor

# The query parameters the site knows, and their types: anything else gets
# "not found" (404) before a single attack pattern runs, and the attack
# patterns look only at free text -- a number or a word cannot hold an attack.
# Marketing tags (utm_*, fbclid, gclid, ...) come from the library's
# rules/tracking.rules, so newsletter and ad links keep working.
include @tracking
[DEMO-PARAMS]       query page int   q text   start word   v id                            # page numbers, the search, how the form box starts, the script's version
[DEMO-PARAMS-RULES] query method word   url text   ip /[0-9A-Fa-f.:]{1,45}/ at **/rules      # the check on the active rules page
[DEMO-PARAMS-STATS] query days int   by word   crawler id   format word   lang word   fragment any   path text   sort word   from /[0-9]{4}-[0-9]{2}-[0-9]{2}/   to /[0-9]{4}-[0-9]{2}-[0-9]{2}/   method word   url text   ip /[0-9A-Fa-f.:]{1,45}/   ua text   site text   rs-g word   rs-exp int   rs-sig word   rs-login word   rs-logout word   cursor /(m:[0-9]{1,20}|[0-9]{1,20}:[0-9]{1,20})/   host text   what word   source word   q text   address text   note text   kind word   for word at **/rs/**   # the statistics: the period, one crawler, a subtree, the order, JSON, the rule tester
[DEMO-PARAMS-ANSWER] query n /[0-9]{1,3}\.[0-9]{1,3}/ at **/__answer   # the row whose answer the front page asks for
[DEMO-STRICT]       query strict                                  # any other parameter, or a value not of its type: 404

[DEMO-FORMS]        allow POST  **/edit **/comment **/profile **/contact **/rs/waf/lists     # forms may only be sent to the edit, comment, profile and contact pages -- and the lists

# The admin area, as a block: the rules of one area in one place, the path
# written once (the same as "restrict **/admin/** to 192.0.2.0/24").
match **/admin/** {
  [DEMO-ADMIN]      restrict to 192.0.2.0/24                      # the admin area: only the office network
}
[DEMO-API]          restrict **/api/**    to 127.0.0.1 ::1        # the API: only this machine
[DEMO-RULES]        restrict **/rules     to 127.0.0.1 ::1        # this rules page: only this machine

# The path check stays even here: /files/%2e%2e/secret is still refused (400).
# @1: the revision of the built-in rules this was reviewed for -- when a library
# update changes them, check and /rules say so (the rules keep applying).
match **/files/** {
  [DEMO-FILES]      unblock [SCAN-HIDDEN@1] [SCAN-BACKUP@1] for 127.0.0.1 ::1   # the admin's file reader may open hidden files and backups, from this machine
}

[DEMO-PACE]         limit requests 60/min challenge-at 20 on-exceeded challenge   # per visitor: the browser check past 20 requests a minute; past 60 a check that frees the counter (instead of a pause)

# Budgets the pages count themselves (on-demand), earned back with the check:
# the edit form 3 times a minute (index.php: consume('edits', answer: true)),
# the API 5 calls a minute -- an API gets the task as JSON in a header.
[DEMO-EDITS]        limit edits 3/min on-demand on-exceeded challenge          # the edit form: 3 a minute, then the check -- and the form is sent again
[DEMO-CALLS]        limit calls 5/min on-demand on-exceeded challenge          # the API: 5 calls a minute, then the task in a header
[DEMO-APIPATH]      api-path **/api/**                                         # the API's addresses: a check there is JSON, not a page
[DEMO-LOGIN]        challenge   **/challenge                       # a page where every visitor is checked, as a login would be
[DEMO-CHECKOUT]     challenge   **/checkout max-age 20s            # the checkout: a pass from the last 20 seconds, however long the pass lives

# How hard the shield acts: enforce (as here), monitor (everything logged as
# it would be decided, nobody refused -- to try new rules on a live site),
# strict (under attack: tighter values), off. Single rules can be watched
# with "monitor" in front: logged, not enforced.
set         mode enforce
[DEMO-OLD]          monitor block **/old/**                        # watched before it is switched on: the old API would be refused -- the log says so, nobody is

# The demo runs on your own machine: count localhost too (a real site exempts
# its monitoring and its own servers here).
[DEMO-EXEMPT]       exempt none                                    # nobody is exempt from counting, not even this machine

# A passed check is valid for one minute here, so you can watch it expire; a
# real site keeps it an hour or more (the default: 1h).
set         pass-ttl 1m
set         difficulty-min 50000
set         difficulty-max 300000
# Crawlers are recognised by their published address lists only: no DNS
# lookups from the demo (on your machine they are all "claimed" anyway).
set         crawler-verify ranges

# Statistics: what the shield did, per hour (bin/request-shield stats, or /rs/dashboard).
[DEMO-STATS]        restrict **/rs/**     to 127.0.0.1 ::1        # the statistics -- /rs/dashboard, /rs/stats, /rs/shield: only this machine
set         stats on
set         dashboard-path /rs                                     # the statistics: /rs/dashboard, /rs/stats, /rs/shield; /rs/live and /rs/lists (restricted above)

# The live view (/rs/live) from memory: the last requests stopped, with the full
# address (so one can be kept out exactly), for an hour, never on disk (APCu).
set         live on

# Public blocklists (docs/features/RSF01-03-blocklist-feeds.md): off until a rule names one.
# Fetched by cron (bin/request-shield feeds request-shield.rules update), never
# per request. Try a list first: "count" only counts and logs what it would do.
#[DEMO-DROP]        feed spamhaus-drop count                       # hijacked networks; later: deny
#[DEMO-DSHIELD]     feed dshield-top20 count                       # the networks scanning most; later: check (non-commercial terms)
[DEMO-FEED]         feed demo-blocklist from feeds/demo-blocklist.txt deny   # a blocklist in a file beside the rules: read with them, never fetched

# An address the site keeps out for good (the dashboard's lists add to this).
[DEMO-DENY]         deny 203.0.113.66                             # a documentation address

# A crawler of the demo's own, proved by its published address list -- and the
# site does not want it. (Real crawlers come with the library: rules/crawlers.rules.)
[DEMO-BOT]          crawler ai-training ua /DemoBot/ ranges crawlers/demo-bot.json   # documentation ranges
[DEMO-BOT-NO]       crawler DEMO-BOT block

# Automatic bans -- watched only here (monitor): the log says whom they would
# have banned, nobody is (a demo that bans this machine would be no demo).
[DEMO-SCAN]         monitor ban after 5 refusals in 5m for 10m    # a scanner: five refusals for what only attackers ask for
set         stats-depth 4                                          # sections to the fourth folder: the demo lives under /qbixserver/request-shield/examples/demo/
set         stats-hosts localhost84 127.0.0.1                     # statistics per website: these two names; any other Host counts as "other hosts"
stats-group "Customer A" localhost84                           # websites per customer: read together, and each on its own
stats-group "Customer B" 127.0.0.1
# Who may read the dashboard: only the tokens' hashes (bin/request-shield access-token "Customer A").
# Demo tokens, printed on /customer-menu (a demo only): this machine is the admin anyway.
[DEMO-ADMIN-READ]  dashboard-access *            sha256:9ff78c7acc39ebe339d300fe2232236d77a34e8a67873660cfb4c7b91a07b926
[DEMO-CUSTOMER-A]  dashboard-access "Customer A" sha256:da431e0d8f3f77f08110271b900c7ffa3f3fcb385a67a40637494364155cd54d

# Counters, the generated secret and the log: outside the document root,
# never in a directory a web server might hand out (the tests set the variable).
set         store-dir ${REQUEST_SHIELD_DEMO_VAR:-/tmp/request-shield-demo}
set         log ${REQUEST_SHIELD_DEMO_VAR:-/tmp/request-shield-demo}/shield.log
set         log-level flag
set         recheck 0

# The site may ask for the browser check itself: Shield::active()->requirePass()
# when a comment is sent (/comment), or the response header
# X-RS-Check: 1 on a page (/profile) -- the latter needs:
set         app-challenge on

# The browser check inside a form (/contact): the box fetches its task here,
# while the visitor types -- the page itself stays cacheable.
set         widget-path ${REQUEST_SHIELD_DEMO_HOME:-/}request-shield

# The shield's own pages (404, 403, a pause, the check page) link back here:
# the demo sets the variable to its own front page, wherever it lives.
set         home ${REQUEST_SHIELD_DEMO_HOME:-/}

# X-RS: <decision> <reason>; rule=<ID> on every response.
set         debug-header on

# ── The demo page's rows, by feature (0031 F.4) ─────────────────────────────
# Each group is a feature of the docs (RSF<gg>-<nn>): its comment lines are
# the explanation on the page, its expect lines the rows -- clicked from this
# machine, decided by request-shield test from a documentation address unless
# "from" says otherwise. "# try:" rows are there to look at, not decided.

# demo: RSF01-01 trusted-proxies A proxy in front of the site
# Behind a proxy, every request comes from the proxy's address. From a trusted
# proxy (trust 198.51.100.1), X-Forwarded-For names the visitor -- and only
# from there: anyone can send the header.
expect GET /admin/      from 198.51.100.1 header X-Forwarded-For:192.0.2.10 answered          # Through the trusted proxy, a visitor from the office: the visitor's address decides
expect GET /admin/      from 198.51.100.1 header X-Forwarded-For:203.0.113.9 403 by DEMO-ADMIN # the same proxy, a visitor from elsewhere
expect GET /admin/      from 203.0.113.50 header X-Forwarded-For:192.0.2.10 403 by DEMO-ADMIN # The header from anyone else: not believed

# demo: RSF01-02 ip-lists Addresses kept out, and bans
# An address on the deny list is refused before anything else. A scanner that
# piles up refusals is banned for a while -- in the demo the ban is only
# watched (monitor), so the log says what would happen; test decides it on.
expect GET /            from 203.0.113.66 403 by DEMO-DENY               # An address on the deny list
expect GET /            from 203.0.113.67 answered                       # its neighbour
expect GET /.env        from 203.0.113.70 times 6 429 by DEMO-SCAN       # A scanner, the sixth refusal in five minutes: banned
expect GET /.env        from 203.0.113.71 times 5 404 by SCAN-HIDDEN     # the fifth: still only refused
# try: GET /rs/waf/lists The lists: keep an address out or let it in, with a comment of your own

# demo: RSF01-03 blocklist-feeds Public blocklists
# Addresses on a list are kept out before anything else. A public list is
# fetched by request-shield feeds … update; this one is a file beside the
# rules (feed … from), read with them -- for a demo, or a server without the
# internet.
expect GET /            from 203.0.113.140 403 by DEMO-FEED   # An address in a range on the list
expect GET /            from 203.0.113.20 answered           # an address outside it
expect GET /            from 198.51.100.200 403 by DEMO-FEED  # A single address on the list

# demo: RSF01-04 known-crawlers Crawlers that prove who they are
# A crawler names itself in its User-Agent -- anyone can. The shield believes
# the name only from the crawler's published addresses (or DNS), then does what
# the site wants with it: allow, check or block, by kind or one by one.
expect GET /  ua "Mozilla/5.0 (compatible; DemoBot/1.0)" from 192.0.2.40 403 by DEMO-BOT-NO   # DemoBot from its own addresses: proved, and the site blocks it
expect GET /  ua "Mozilla/5.0 (compatible; DemoBot/1.0)" from 198.51.100.7 answered          # the same name from elsewhere: only a claim, an ordinary visitor
expect GET /  from 192.0.2.40 answered                                                       # a browser from DemoBot's addresses

# demo: RSF04-01 cacheable-definition What a cache may keep
# Every page passes; only some may be kept by a cache. Unknown paths and
# parameters reach the site, but marked so a cache does not keep them -- made-up
# URLs cannot fill it.
expect GET /                          passes        # A normal page
expect GET /page/about                passes        # A known page
expect GET /?utm_source=newsletter    uncached      # A link from a newsletter: a known marketing tag, not for a cache
expect GET /random/abc                uncached      # An unknown path: the site answers it (200 or 404), a cache must not keep it

# demo: RSF02-02 blocked-paths Paths only attackers ask for
# Hidden files, backups, database tools: refused before the site runs, with
# "not found" -- the scanner learns nothing.
expect GET /.env                      404 by SCAN-HIDDEN     # What a scanner looks for
expect GET /backup.sql                404 by SCAN-BACKUP     # A backup
expect GET /files/.env                from 127.0.0.1 answered   # The admin's file reader: hidden files open at /files/ only, from this machine
expect GET /files/.env                404 by SCAN-HIDDEN     # the same address from anywhere else

# demo: RSF02-01 hard-rejects Broken requests
# A path that leaves the site's folder, however it is encoded, never reaches
# the site.
expect GET /files/%2e%2e/secret       400 by built-in        # Leaving the site's folder
expect GET /files/secret              from 127.0.0.1 answered   # the same folder, a plain name

# demo: RSF02-05 known-parameters Known query parameters
# The site's parameters and their types: anything else is "not found" before a
# single attack pattern runs.
expect GET /?page=2                   answered               # A number where a number belongs
expect GET /?page=2%27                404 by DEMO-STRICT     # A parameter not of its type
expect GET /?debug=1                  404 by DEMO-STRICT     # A parameter the site does not know
expect GET /?page=2&fbclid=x&gclid=y  answered               # Marketing tags (the built-in tracking list)

# demo: RSF02-03 access-rules Doors for certain people
# Areas by address, forms by path: the office network for the admin area, this
# machine for the API and the rules page; a form only where one belongs.
expect GET /admin/                    403 by DEMO-ADMIN      # The admin area: only the office network
expect GET /admin/                    from 192.0.2.10 answered  # from the office network
expect GET //admin/                   403 by DEMO-ADMIN      # The admin area, sneaked: //, %61 and case do not get past it
expect GET /api/status                403 by DEMO-API        # The API, from anywhere else
expect GET /api/status                from 127.0.0.1 answered   # The API, from this machine
expect POST /page/about               405 by DEMO-FORMS      # A form where none belongs
expect POST /edit                     answered               # A form where one belongs

# demo: RSF03-02 browser-challenge The browser check
# A page where every visitor is checked, as a login would be: the invisible
# check once, then the page. The checkout asks for a fresh pass.
expect GET /challenge                 check by DEMO-LOGIN    # A page that always checks the browser
expect GET /challenge                 with pass answered     # with a pass: the page
expect GET /checkout                  check by DEMO-CHECKOUT # A checkout: only a fresh pass
expect GET /checkout                  with pass answered     # a pass from a moment ago
# try: GET /reset Forget my pass: the check comes back on /challenge

# demo: RSF03-01 budgets Budgets and pace
# Requests per visitor: past 20 a minute the invisible check, past 60 a check
# that frees the counter -- no pause.
expect GET /                          times 21 check by DEMO-PACE   # Any page, 21 times in a minute
expect GET /                          times 20 answered      # 20 times: still the page
# try: GET /search?q=shield The search counts its own budget: past 10 a minute, a pause
# try: POST /edit The edit form a 4th time within a minute: the check, then the form is sent again

# demo: RSF05-03 modes A rule being watched
# "monitor" before a rule: the log notes what it would do, nobody is refused.
# request-shield test decides it switched on; the page lets it through.
expect GET /old/news                  404 by DEMO-OLD        # An old page: refused once switched on -- watched, it passes
expect GET /older                     answered               # a near miss

# demo: RSF03-04 app-challenges The site asks for the check
# The page decides: a comment needs a pass, a page sends X-RS-Check: 1. A rule
# cannot show it -- click.
# try: GET /comment A comment form: sending it needs a pass, then the comment is sent again by itself
# try: GET /profile A page that asks for the check with a header

# demo: RSF03-03 browser-check-in-the-form The check inside the form
# A box in the form checks while the visitor types; the form goes straight
# through, a file too.
# try: GET /contact The contact form with the box

# demo: RSF06-01 active-rules-page The active rules page
# Every rule in plain words, with a check for any address: this machine only.
expect GET /rules                     403 by DEMO-RULES      # from anywhere else
expect GET /rules                     from 127.0.0.1 answered   # The active rules, from this machine
# try: GET /rs/waf/rules Rules & setup in the dashboard: the way of a request, every rule

# demo: RSF06-02 live-and-lists Live and the lists
# What the shield stops right now, and the lists: this machine only.
expect GET /rs/waf/live               403 by DEMO-STATS      # from anywhere else
expect GET /rs/waf/live               from 127.0.0.1 answered   # Live, from this machine
# try: GET /rs/waf/lists Keep an address out or let it in, with a comment of your own

# demo: RSF06-03 statistics The statistics
# Who came, what the shield did, pages, crawlers, rules -- per website and per
# customer: this machine only, or a customer's signed link.
expect GET /rs/stats/overview         403 by DEMO-STATS      # from anywhere else
expect GET /rs/stats/overview         from 127.0.0.1 answered   # The overview, from this machine
# try: GET /rs/stats/visitors Visitors & pages, for editors
# try: GET /rs/stats/protection Protection, for admins
# try: GET /rs/stats/sites All websites, by customer
# try: GET /rs/stats/visitors?lang=de Statistik auf Deutsch
# try: GET /customer-menu A customer's menu: a signed link opens Customer A's statistics only
