# The showcase's rules: what a small website would write -- real values, not
# demo values. Every try card on the page is one "expect" line, right below
# the rule it is about, and `php bin/request-shield test
# examples/showcase/showcase.rules` decides them all: the page cannot promise
# what the rules do not do.

ids SHOW                                              # every rule's name starts with SHOW-: decisions and the log name it
version 2026-10-07.1                                  # this rule set's own version

# The page sends each try as a visitor of its own (X-Forwarded-For from this
# machine), so a try never blocks you. A real site trusts its proxy here.
trust       127.0.0.1 ::1                             # the proxy in front: from it, X-Forwarded-For names the visitor

# Built in, without a line: scanners' paths, path traversal, broken requests.
expect GET  /                       from 198.51.100.10 answered              # A visitor reads the front page
expect GET  /.env                   from 198.51.100.11 404 by SCAN-HIDDEN    # A scanner looks for your passwords
expect GET  /.git/config            from 198.51.100.12 404 by SCAN-HIDDEN    # ... for your source code
expect GET  /phpmyadmin/            from 198.51.100.13 404 by SCAN-DBTOOL    # ... for a database tool
expect GET  /backup.sql             from 198.51.100.14 404 by SCAN-BACKUP    # ... for a forgotten backup
expect DELETE /api/v1/products/7    from 198.51.100.44 405                   # A method the site does not take (built in: GET, HEAD, POST, OPTIONS)

include @tracking                                     # utm_*, fbclid, gclid: newsletter and ad links keep working
expect GET  /?utm_source=newsletter from 198.51.100.19 answered              # A newsletter link: welcome
include @attacks                                      # SQL injection, XSS, shell commands -- in the free text only
expect GET  /?q=1%27%20UNION%20SELECT%20password%20FROM%20users-- from 198.51.100.15 403 by ATK-SQL-UNION   # SQL injection in the search

[SHOW-PARAMS]  query page int   q text   lang word    # the parameters the site knows, and their types
expect GET  /?page=2                from 198.51.100.16 answered              # A page number that is a number
[SHOW-STRICT]  query strict                           # any other parameter, or a wrong type: 404
expect GET  /?page=2%27             from 198.51.100.17 404 by SHOW-STRICT    # A page "number" that is not one
expect GET  /?debug=1               from 198.51.100.18 404 by SHOW-STRICT    # A parameter the site does not know

[SHOW-PACE]    limit requests 120/min challenge-at 60  # per visitor: 60 a minute pass silently, then the invisible check, past 120 a pause
expect GET  /                       from 198.51.100.25 times 61 check by SHOW-PACE   # 61 pages in a minute: the invisible check
expect GET  /                       from 198.51.100.26 times 121 429 by SHOW-PACE    # 121 in a minute: a pause

[SHOW-FORMS]   allow POST /contact /account/login     # forms may only be sent to the contact page and the sign-in
expect POST /search                 from 198.51.100.22 405 by SHOW-FORMS     # A POST where no form is
[SHOW-ORIGIN]  post-origin same                       # ... and only from the site's own pages
expect POST https://www.example.org/contact header Origin:https://www.example.org from 198.51.100.20 answered             # The contact form, from the site
expect POST https://www.example.org/contact header Origin:https://spam.example    from 198.51.100.21 403 by SHOW-ORIGIN   # The contact form, sent from elsewhere

match /admin/** {
  [SHOW-ADMIN] restrict to 192.0.2.0/24               # the admin area: only the office network
}
expect GET  /admin/                 from 192.0.2.10    answered              # The admin area, from the office
expect GET  /admin/                 from 203.0.113.9   403 by SHOW-ADMIN     # The admin area, from anywhere else

[SHOW-LOGIN]   challenge /login                       # the login: every visitor is checked (invisibly) first
expect GET  /login                  from 198.51.100.23 check by SHOW-LOGIN   # The login: checked first
expect GET  /login                  from 198.51.100.24 with pass answered    # ... with a pass: straight in

[SHOW-DENY]    deny 203.0.113.66                      # an address kept out for good
expect GET  /                       from 203.0.113.66  403 by SHOW-DENY      # An address on the deny list

[SHOW-SEARCH]     limit searches 5/min on-demand at /search          # the search counts itself: 5 searches a minute per visitor
[SHOW-SEARCH-BAN] ban after 1 searches in 1m for 5s                  # past them a pause: 5 seconds, then 10, 20, 40 …
[SHOW-LOGINS]     limit logins 3/15m on-demand at /account/login     # the sign-in counts wrong passwords: 3 in 15 minutes
[SHOW-LOGIN-BAN]  ban after 1 logins in 15m for 5s                   # then a pause: 5 seconds, then 10, 20, 40 …
set         ban-growth 2                              # every pause twice as long as the one before
set         ban-max 5m                                # but never longer than five minutes

# The API: a form sends JSON to it, other programs read products as JSON or XML.
api-path /api/**                                      # a check there is JSON with a header, never a page a program cannot show
match /api/** {
  [SHOW-API-POST]   allow POST                         # a POST is let in here (and only where a rule allows it); PUT, DELETE … get 405 anyway
  expect POST https://www.example.org/api/v1/messages header Origin:https://www.example.org from 198.51.100.47 with pass answered   # A message with a pass: it arrives
  [SHOW-API-QUERY]  query page int   limit int   format /(json|xml)/   # its parameters, typed: anything else 404 (query strict)
  expect GET  /api/v1/products                from 198.51.100.40 answered              # The product list, as JSON
  expect GET  /api/v1/products?format=xml     from 198.51.100.41 answered              # ... as XML
  expect GET  /api/v1/products?page=2%27      from 198.51.100.42 404 by SHOW-STRICT    # A page "number" that is not one
  expect GET  /api/v1/products?debug=1        from 198.51.100.43 404 by SHOW-STRICT    # A parameter the API does not know
  [SHOW-API-PACE]   limit api 30/min                   # per visitor: 30 calls a minute, then 429 with Retry-After
  expect GET  /api/v1/products                from 198.51.100.45 times 31 429 by SHOW-API-PACE   # 31 calls in a minute: a pause
  [SHOW-API-WRITE]  challenge POST                     # every write needs a pass: a browser solves the task unseen, a script pays per request
  expect POST https://www.example.org/api/v1/messages header Origin:https://www.example.org from 198.51.100.46 check by SHOW-API-WRITE   # A message without a pass: the check, as JSON
  expect POST https://www.example.org/api/v1/messages header Origin:https://spam.example from 198.51.100.48 check by SHOW-API-WRITE      # ... from another website: post-origin does not apply to an API (programs send no Origin) -- the check does, and the browser's CORS
}

crawlers ai-training block                            # verified AI training crawlers: no

# The showcase's own settings (a real site keeps the defaults).
set         debug-header on                           # X-RS: <decision> on every answer, so the page can show it
set         crawler-verify ranges                     # no DNS lookups from a demo
set         difficulty-min 500000                     # the check a little harder, so you can watch the ring (a real site keeps the default, 50000)
set         difficulty-max 500000
[SHOW-EXEMPT]  exempt none                            # this machine is counted and checked too (by default it is exempt: a site's own monitoring)
expect GET  /login                  from 127.0.0.1     check by SHOW-LOGIN   # (you, on this machine: checked too -- not a card)
set         dashboard-path /rs
set         widget-path /rs-check                     # the check's script (widget.js): the page solves the API's task with it
[SHOW-TRY]     query n int at /__try /__exp                # the page's own address for the one try a browser cannot send
expect GET  /__try?n=1              from 198.51.100.28 answered              # (the page's own address: not a card)
[SHOW-LEARN]   allow POST /__learn/start /__learn/stop    # the page on building rules: start and stop a learning run (only from this machine)
expect POST /__learn/start header Origin:https://www.example.org from 198.51.100.29 answered   # (the page's own address: not a card)
[SHOW-RS]      restrict /rs/** to 127.0.0.1 ::1        # the shield's own pages: only this machine
expect GET  /rs/dashboard           from 198.51.100.27 403 by SHOW-RS        # The shield's own pages, from outside
set         store-dir ${REQUEST_SHIELD_SHOWCASE_VAR:-/tmp/request-shield-showcase}
set         log ${REQUEST_SHIELD_SHOWCASE_VAR:-/tmp/request-shield-showcase}/shield.log   # what the shield stopped, checked or slowed down; the page shows its end (/__log)
set         recheck 0
