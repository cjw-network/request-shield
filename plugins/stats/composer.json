{
    "name": "cjw-network/request-shield-stats",
    "description": "The statistics of request-shield: what the shield let through and refused, per day, page and site, with times and cache results -- counted without cookies or addresses.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/cjw-network/request-shield",
    "authors": [
        {
            "name": "JAC Systeme GmbH",
            "homepage": "https://www.jac-systeme.de",
            "role": "Author"
        },
        {
            "name": "CJW Network",
            "homepage": "https://cjw-network.com"
        }
    ],
    "keywords": [
        "request-shield",
        "statistics",
        "analytics",
        "privacy"
    ],
    "support": {
        "issues": "https://github.com/cjw-network/request-shield/issues",
        "source": "https://github.com/cjw-network/request-shield/tree/main/plugins/stats",
        "security": "https://github.com/cjw-network/request-shield/security/policy"
    },
    "require": {
        "php": ">=8.0",
        "cjw-network/request-shield": "^1.0"
    },
    "suggest": {
        "cjw-network/request-shield-api": "Its endpoints (/stats/...) in the API",
        "cjw-network/request-shield-cache": "The cache's own refusal reasons in the statistics"
    },
    "autoload": {
        "psr-4": {
            "CjwNetwork\\RequestShield\\Stats\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
